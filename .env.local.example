# Copy this file to .env.local and fill in your own values.
# These NEXT_PUBLIC_ values are safe for the browser (anon key only).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# The n8n webhook that wakes the agent (from the n8n workflow).
# Example: https://YOUR-SUBDOMAIN.ngrok-free.dev/webhook/inbox-agent
NEXT_PUBLIC_N8N_AGENT_WEBHOOK=https://YOUR-N8N-URL/webhook/inbox-agent
